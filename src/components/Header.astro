---
const navLinks = [
	{ href: '#about', label: 'こだわり' },
	{ href: '#shop', label: '店舗情報' },
];
---

<header id="header" class="fixed top-0 left-0 w-full z-50 transition-all duration-300">
	<div class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between h-16 md:h-20">
		<!-- ロゴ -->
		<a href="#" class="header-link font-serif font-black text-xl md:text-2xl text-white transition-colors duration-300">
			中島屋
		</a>

		<!-- デスクトップナビ -->
		<nav class="hidden md:flex items-center gap-8" aria-label="メインナビゲーション">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class="header-link text-white hover:text-accent transition-colors duration-300"
				>
					{link.label}
				</a>
			))}
		</nav>

		<!-- モバイルハンバーガーボタン -->
		<button
			id="menu-toggle"
			class="md:hidden relative w-8 h-8 flex flex-col items-center justify-center gap-1.5"
			aria-label="メニューを開く"
			aria-expanded="false"
		>
			<span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
			<span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
			<span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300 origin-center"></span>
		</button>
	</div>
</header>

<!-- モバイルメニューオーバーレイ -->
<div id="mobile-menu" class="fixed inset-0 z-40 bg-base/95 backdrop-blur-sm hidden md:hidden">
	<nav class="flex flex-col items-center justify-center h-full gap-8" aria-label="モバイルナビゲーション">
		{navLinks.map((link, i) => (
			<a
				href={link.href}
				class="mobile-nav-link text-2xl text-text hover:text-accent transition-colors duration-200 py-3 px-6"
				style={`transition-delay: ${i * 100}ms`}
			>
				{link.label}
			</a>
		))}
	</nav>
</div>

<script>
	const header = document.getElementById('header');
	const toggle = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');
	const mobileLinks = document.querySelectorAll('.mobile-nav-link');
	let isMenuOpen = false;

	// スクロール時のヘッダー背景・テキスト色変化
	const headerLinks = document.querySelectorAll('.header-link');
	const menuLines = document.querySelectorAll('.menu-line');

	window.addEventListener('scroll', () => {
		if (window.scrollY > window.innerHeight) {
			header?.classList.add('backdrop-blur-xl', 'bg-base/80', 'shadow-sm');
			headerLinks.forEach((link) => {
				link.classList.remove('text-white');
				link.classList.add('text-text');
			});
			menuLines.forEach((line) => {
				line.classList.remove('bg-white');
				line.classList.add('bg-text');
			});
		} else {
			header?.classList.remove('backdrop-blur-xl', 'bg-base/80', 'shadow-sm');
			headerLinks.forEach((link) => {
				link.classList.remove('text-text');
				link.classList.add('text-white');
			});
			menuLines.forEach((line) => {
				line.classList.remove('bg-text');
				line.classList.add('bg-white');
			});
		}
	}, { passive: true });

	// メニュー開閉
	function openMenu() {
		isMenuOpen = true;
		mobileMenu?.classList.remove('hidden');
		toggle?.setAttribute('aria-label', 'メニューを閉じる');
		toggle?.setAttribute('aria-expanded', 'true');
		toggle?.classList.add('menu-open');
		document.body.style.overflow = 'hidden';
	}

	function closeMenu() {
		isMenuOpen = false;
		mobileMenu?.classList.add('hidden');
		toggle?.setAttribute('aria-label', 'メニューを開く');
		toggle?.setAttribute('aria-expanded', 'false');
		toggle?.classList.remove('menu-open');
		document.body.style.overflow = '';
	}

	function toggleMenu() {
		if (isMenuOpen) {
			closeMenu();
		} else {
			openMenu();
		}
	}

	toggle?.addEventListener('click', toggleMenu);

	// モバイルメニューリンクのクリックでメニューを閉じてスクロール
	mobileLinks.forEach((link) => {
		link.addEventListener('click', (e) => {
			const href = (link as HTMLAnchorElement).getAttribute('href');
			if (href && href.startsWith('#')) {
				e.preventDefault();
				closeMenu();
				// メニューが閉じた後にスクロール
				setTimeout(() => {
					const target = document.querySelector(href);
					target?.scrollIntoView({ behavior: 'smooth' });
				}, 50);
			}
		});
	});

	// Escapeキーでモバイルメニューを閉じる
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && isMenuOpen) {
			closeMenu();
			toggle?.focus();
		}
	});
</script>

<style>
	/* ハンバーガー → X のアニメーション */
	.menu-line {
		transition: transform 0.3s ease, opacity 0.3s ease;
	}

	#menu-toggle.menu-open .menu-line:nth-child(1) {
		transform: rotate(45deg) translate(5px, 5px);
	}

	#menu-toggle.menu-open .menu-line:nth-child(2) {
		opacity: 0;
	}

	#menu-toggle.menu-open .menu-line:nth-child(3) {
		transform: rotate(-45deg) translate(5px, -5px);
	}
</style>
