---
const navLinks = [
  { href: "#about", label: "こだわり" },
  { href: "#shop", label: "店舗情報" },
]
---

<header
  id="header"
  class="fixed top-0 left-0 w-full z-50 transition-all duration-300"
>
  <div
    class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between h-16 md:h-20"
  >
    <!-- ロゴ -->
    <a
      href="#"
      class="header-link font-serif font-black text-xl md:text-2xl text-white transition-colors duration-300"
    >
      上州豚骨 中島屋
    </a>

    <!-- デスクトップナビ -->
    <nav
      class="hidden md:flex items-center gap-8"
      aria-label="メインナビゲーション"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="header-link text-white hover:text-accent transition-colors duration-300"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- モバイルハンバーガーボタン -->
    <button
      id="menu-toggle"
      class="md:hidden relative w-8 h-8 flex flex-col items-center justify-center gap-1.5"
      aria-label="メニューを開く"
      aria-expanded="false"
    >
      <span
        class="menu-line block w-6 h-0.5 bg-white transition-all duration-300 origin-center"
      ></span>
      <span
        class="menu-line block w-6 h-0.5 bg-white transition-all duration-300 origin-center"
      ></span>
      <span
        class="menu-line block w-6 h-0.5 bg-white transition-all duration-300 origin-center"
      ></span>
    </button>
  </div>
</header>

<!-- モバイルメニューオーバーレイ -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-base-alt/95 backdrop-blur-xl hidden md:hidden"
>
  <nav
    class="flex flex-col items-center justify-center h-full gap-2 pb-16"
    aria-label="モバイルナビゲーション"
  >
    <!-- 装飾線 -->
    <div class="w-12 h-0.5 bg-accent mb-8"></div>
    {
      navLinks.map((link, i) => (
        <a
          href={link.href}
          class="mobile-nav-link text-xl text-white hover:text-accent tracking-[0.2em] transition-colors duration-300 py-4 px-8"
          style={`transition-delay: ${i * 100}ms`}
        >
          {link.label}
        </a>
      ))
    }
    <!-- お問い合わせリンク -->
    <a
      href="https://www.try-catch.co.jp/contact"
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-nav-link inline-flex items-center gap-1 text-sm text-white/70 hover:text-accent tracking-[0.15em] transition-colors duration-300 py-3 px-8"
      style={`transition-delay: ${navLinks.length * 100}ms`}
    >
      お問い合わせ
      <svg
        class="w-3.5 h-3.5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
        ></path>
      </svg>
    </a>
  </nav>
</div>

<script>
  const header = document.getElementById("header")
  const toggle = document.getElementById("menu-toggle")
  const mobileMenu = document.getElementById("mobile-menu")
  const mobileLinks = document.querySelectorAll(".mobile-nav-link")
  let isMenuOpen = false

  // スクロール時のヘッダー背景・テキスト色変化
  const headerLinks = document.querySelectorAll(".header-link")
  const menuLines = document.querySelectorAll(".menu-line")

  function updateHeaderColors() {
    const scrolled = window.scrollY > window.innerHeight
    if (scrolled) {
      header?.classList.add("backdrop-blur-xl", "bg-base/80", "shadow-sm")
      headerLinks.forEach((link) => {
        link.classList.remove("text-white")
        link.classList.add("text-text")
      })
    } else {
      header?.classList.remove("backdrop-blur-xl", "bg-base/80", "shadow-sm")
      headerLinks.forEach((link) => {
        link.classList.remove("text-text")
        link.classList.add("text-white")
      })
    }
    // メニューが開いている間は×ボタンを常に白に
    if (isMenuOpen) {
      menuLines.forEach((line) => {
        line.classList.remove("bg-text")
        line.classList.add("bg-white")
      })
    } else if (scrolled) {
      menuLines.forEach((line) => {
        line.classList.remove("bg-white")
        line.classList.add("bg-text")
      })
    } else {
      menuLines.forEach((line) => {
        line.classList.remove("bg-text")
        line.classList.add("bg-white")
      })
    }
  }

  window.addEventListener("scroll", updateHeaderColors, { passive: true })

  // メニュー開閉
  function openMenu() {
    isMenuOpen = true
    mobileMenu?.classList.remove("hidden")
    toggle?.setAttribute("aria-label", "メニューを閉じる")
    toggle?.setAttribute("aria-expanded", "true")
    toggle?.classList.add("menu-open")
    document.body.style.overflow = "hidden"
    updateHeaderColors()
  }

  function closeMenu() {
    isMenuOpen = false
    mobileMenu?.classList.add("hidden")
    toggle?.setAttribute("aria-label", "メニューを開く")
    toggle?.setAttribute("aria-expanded", "false")
    toggle?.classList.remove("menu-open")
    document.body.style.overflow = ""
    updateHeaderColors()
  }

  function toggleMenu() {
    if (isMenuOpen) {
      closeMenu()
    } else {
      openMenu()
    }
  }

  toggle?.addEventListener("click", toggleMenu)

  // モバイルメニューリンクのクリックでメニューを閉じてスクロール
  mobileLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = (link as HTMLAnchorElement).getAttribute("href")
      if (href && href.startsWith("#")) {
        e.preventDefault()
        closeMenu()
        // メニューが閉じた後にスクロール
        setTimeout(() => {
          const target = document.querySelector(href)
          target?.scrollIntoView({ behavior: "smooth" })
        }, 50)
      }
    })
  })

  // Escapeキーでモバイルメニューを閉じる
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isMenuOpen) {
      closeMenu()
      toggle?.focus()
    }
  })
</script>

<style>
  /* ハンバーガー → X のアニメーション */
  .menu-line {
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }

  #menu-toggle.menu-open .menu-line:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  #menu-toggle.menu-open .menu-line:nth-child(2) {
    opacity: 0;
  }

  #menu-toggle.menu-open .menu-line:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }
</style>
