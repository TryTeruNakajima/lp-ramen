---
---

<section id="shop" class="py-20 md:py-32 bg-base">
  <div class="max-w-7xl mx-auto px-4 md:px-8">

    <!-- セクションヘッダー -->
    <div class="text-center mb-8 md:mb-16" data-animate="fade-in-up">
      <p class="text-accent text-sm tracking-[0.3em] mb-2">SHOP INFO</p>
      <h2 class="font-serif font-bold text-3xl md:text-4xl text-text">店舗情報</h2>
      <div class="bg-accent h-0.5 w-16 mx-auto mt-4" data-animate="line-draw"></div>
    </div>

    <!-- 2カラムグリッド -->
    <div class="grid md:grid-cols-2 gap-12">

      <!-- 店舗情報リスト（5項目） -->
      <div>
        <dl>
          <div class="flex py-4 border-b border-border" data-animate="fade-in-up" style="transition-delay: 0.1s">
            <dt class="w-24 md:w-32 text-text-muted font-bold shrink-0">所在地</dt>
            <dd class="text-text">〒154-0003 東京都世田谷区野沢2-14-8 ANNEX92 203</dd>
          </div>
          <div class="flex py-4 border-b border-border" data-animate="fade-in-up" style="transition-delay: 0.2s">
            <dt class="w-24 md:w-32 text-text-muted font-bold shrink-0">最寄駅</dt>
            <dd class="text-text">JR山手線 原宿駅 徒歩5分</dd>
          </div>
          <div class="flex py-4 border-b border-border" data-animate="fade-in-up" style="transition-delay: 0.3s">
            <dt class="w-24 md:w-32 text-text-muted font-bold shrink-0">営業時間</dt>
            <dd class="text-text">11:00〜15:00 / 17:00〜22:00</dd>
          </div>
          <div class="flex py-4 border-b border-border" data-animate="fade-in-up" style="transition-delay: 0.4s">
            <dt class="w-24 md:w-32 text-text-muted font-bold shrink-0">定休日</dt>
            <dd class="text-text">毎週火曜日</dd>
          </div>
          <div class="flex py-4 border-b border-border" data-animate="fade-in-up" style="transition-delay: 0.5s">
            <dt class="w-24 md:w-32 text-text-muted font-bold shrink-0">席数</dt>
            <dd class="text-text">カウンター8席 / テーブル12席</dd>
          </div>
        </dl>
      </div>

      <!-- Google Map -->
      <div
        class="aspect-video border border-border rounded-lg overflow-hidden"
        data-animate="scale-in"
      >
        <iframe
          src="https://maps.google.com/maps?q=東京都世田谷区野沢2-14-8+ANNEX92&output=embed&hl=ja&z=16"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="中島屋 所在地"
        ></iframe>
      </div>

    </div>
  </div>
</section>
